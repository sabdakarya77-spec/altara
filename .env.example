# ===== Database (Fase 1) =====
# Connection string Postgres.
#   - Development di host (Postgres via docker compose):
#       postgres://altara:altara@localhost:5432/altara
#   - Di dalam docker compose (host internal `db`):
#       postgres://altara:altara@db:5432/altara
#   - Managed provider (Neon, Supabase, RDS): pakai URL dari provider.
DATABASE_URL=
# Set "true" bila memakai connection string dari managed provider (Neon, Supabase, RDS).
DATABASE_SSL=false
# Verifikasi sertifikat TLS database (default true bila CA disediakan, atau set false untuk self-signed cert).
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Path atau string berkas root CA certificate (opsional, untuk cloud database bertifikat khusus).
# DATABASE_CA_PATH=
# DATABASE_CA_CERT=
# Jumlah koneksi maksimal pada pool.
DATABASE_POOL_MAX=10

# ===== Admin (Fase 2) =====
# Password tunggal administrator. WAJIB diisi dan diganti sebelum produksi.
# Tanpa nilai ini, `docker compose up` gagal dengan pesan yang jelas, dan login
# admin selalu ditolak (fail closed).
ALTARA_ADMIN_PASSWORD=

# ===== Penyimpanan media (Fase 3) =====
# Folder tujuan upload gambar. Default: <project>/data/uploads
# Pada docker compose, diarahkan ke volume `altara-uploads` (lihat docker-compose.yml).
ALTARA_UPLOAD_DIR=

# ===== Situs =====
# URL kanonik untuk metadata & sitemap.
NEXT_PUBLIC_SITE_URL=https://altara.or.id

# ===== Docker Compose (opsional) =====
# Password Postgres. Default "altara" — WAJIB diganti untuk produksi.
POSTGRES_PASSWORD=altara

# Domain untuk Caddy (TLS otomatis Let's Encrypt).
# Nilai ini harus sudah resolve ke IP publik server, dan port 80/443 terbuka.
CADDY_DOMAIN=altara.or.id

# Email untuk notifikasi pembaruan sertifikat Let's Encrypt.
ACME_EMAIL=admin@altara.or.id

# Endpoint ACME. Untuk uji coba tanpa menyentuh batas rate Let's Encrypt, pakai
# staging: https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
